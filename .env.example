# Local PostgreSQL settings. Copy this file to .env before starting Docker.
POSTGRES_DB=sensoryway
POSTGRES_USER=sensoryway_app
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432

# Provisional values only. Replace after documenting the data-profiling decision.
CROWD_LOW_MAX=50
CROWD_MEDIUM_MAX=150

# Opendatasoft API pagination safeguards.
ETL_PAGE_SIZE=100
ETL_MAX_RECORDS=10000
MINUTE_LOOKBACK_MINUTES=60

# API settings
DATA_STALE_AFTER_MINUTES=30
CORS_ORIGINS=http://localhost:3000
ROUTE_SENSOR_RADIUS_METRES=80
ORS_API_KEY=replace-with-your-openrouteservice-key
ORS_TIMEOUT_SECONDS=10

# User-submitted Melbourne CBD location search. The default is rate-limited and cached.
GEOCODER_SEARCH_URL=https://nominatim.openstreetmap.org/search
GEOCODER_TIMEOUT_SECONDS=8
GEOCODER_MIN_INTERVAL_SECONDS=1
